# --- Site ---
NEXT_PUBLIC_SITE_URL=https://visionforwinchester.example
NEXT_PUBLIC_SITE_NAME="Vision for Winchester"
NEXT_PUBLIC_URBAN_SCIENCE_URL=

# --- Supabase (DB + Storage) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# --- Cloudflare Turnstile (optional; if absent, falls back to honeypot + rate limit) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Mailchimp (optional; if absent, opt-ins are stored in `subscribers` table only) ---
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# --- Resend (optional; if absent, contact messages are stored only) ---
RESEND_API_KEY=
USER_CAMPAIGN_INBOX=hello@example.org
CONTACT_FROM_EMAIL=hello@example.org

# --- Council mailto recipients (TODO: verify before launch) ---
COUNCIL_EMAILS=mtod@winchester.gov.uk,customerservice@winchester.gov.uk,info@partnershipsandplaces.co.uk

# --- Crypto ---
# 32+ random characters; rotate => existing hashes invalidated
HASH_SALT=
# 32 raw bytes, base64-encoded. Generate with:  openssl rand -base64 32
ENCRYPTION_KEY_BASE64=

# --- Admin ---
# Comma-separated list of admin emails (used by future Supabase magic-link auth; informational for MVP).
ADMIN_EMAIL_ALLOWLIST=
# HTTP Basic auth credentials for /admin (MVP). Format: user:password
ADMIN_PASSWORD_FALLBACK=

# --- Validation policy ---
ALLOWED_POSTCODE_OUTWARDS=SO22,SO23
STORE_FULL_POSTCODE=false
SHOW_IMAGE_SOURCES=false
