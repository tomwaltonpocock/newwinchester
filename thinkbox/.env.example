# ── App ──────────────────────────────────────────────────────────────────────
# Public URL of the deployed app (no trailing slash). For local dev:
NEXT_PUBLIC_APP_URL=http://localhost:3100
# Single-user login for the app itself (HTTP Basic Auth), e.g. tom:a-long-passphrase
APP_PASSWORD=tom:change-me-to-a-long-passphrase
# 32-byte key for encrypting Google tokens at rest: openssl rand -base64 32
ENCRYPTION_KEY_BASE64=
# Random string used to authenticate cron sync calls: openssl rand -hex 24
CRON_SECRET=

# ── Google (OAuth for Gmail + Calendar) ──────────────────────────────────────
# Google Cloud console → create project → enable Gmail API + Calendar API →
# OAuth consent screen (External, Testing, add yourself as test user) →
# Credentials → OAuth client ID (Web application) with redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Cheap/fast model for high-volume triage:
TRIAGE_MODEL=claude-haiku-4-5-20251001
# Strong model for drafting in your voice and weekly synthesis:
DRAFTING_MODEL=claude-sonnet-5

# ── Behaviour ────────────────────────────────────────────────────────────────
# If true, classified noise is also archived in Gmail (removed from inbox).
# Default false: noise is only labelled and set aside inside Thinkbox.
ARCHIVE_NOISE=false
# Your usual timezone, used for calendar slot suggestions.
DEFAULT_TIMEZONE=Europe/London
