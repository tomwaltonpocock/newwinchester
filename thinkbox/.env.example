# ── Required (4 things) ──────────────────────────────────────────────────────
# Your login for the app, e.g. tom:a-long-passphrase. Also seeds derived
# secrets — changing it means reconnecting Google.
APP_PASSWORD=

# Google Cloud console → enable Gmail API + Calendar API → OAuth consent
# screen (External, Testing, add yourself as test user) → OAuth client ID
# (Web application) with redirect URI:
#   https://<your-app>.vercel.app/api/auth/google/callback   (and/or http://localhost:3100/... for dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# console.anthropic.com
ANTHROPIC_API_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
# On Vercel: Storage tab → Create Database → Neon (Postgres). DATABASE_URL is
# injected automatically — nothing to paste. Locally, paste the same URL here.
# Schema creates itself on first request; there is no migration step.
# DATABASE_URL=

# ── Optional ─────────────────────────────────────────────────────────────────
# Public URL override (auto-detected on Vercel). For local dev it defaults to
# http://localhost:3100.
# NEXT_PUBLIC_APP_URL=
# Hardens the cron endpoint (Vercel sends it as a bearer token automatically).
# CRON_SECRET=
# Overrides the APP_PASSWORD-derived token-encryption key: openssl rand -base64 32
# ENCRYPTION_KEY_BASE64=
# If true, classified noise is also archived in Gmail. Default: label only.
# ARCHIVE_NOISE=false
# DEFAULT_TIMEZONE=Europe/London
# TRIAGE_MODEL=claude-haiku-4-5-20251001
# DRAFTING_MODEL=claude-sonnet-5
